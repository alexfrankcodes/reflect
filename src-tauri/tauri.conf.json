{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reflect",
  "identifier": "com.alexfrankcodes.reflect",
  "build": {
    "frontendDist": "../src"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["reflect"]
      }
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
